# Legacy optional API client only. Current mobile inference runs offline and ignores this URL.
# To test the isolated legacy client, copy to .env.local and set the computer's Wi-Fi IPv4 address.
# This address is public app configuration, not a secret. Do not use localhost.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:5000
# Android Studio emulator alternative: http://10.0.2.2:5000
# Use an HTTPS base URL for a hosted/release service. Do not append /api/analyze.
